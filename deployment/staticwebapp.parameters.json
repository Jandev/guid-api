{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "resourceGroupName": {
      "value": "rg-guid-api"
    },
    "staticWebAppName": {
      "value": "guid-api-swa"
    },
    "location": {
      "value": "East US 2"
    },
    "repositoryUrl": {
      "value": "https://github.com/your-username/guid-api"
    },
    "repositoryToken": {
      "value": "your-github-pat-token-here"
    },
    "branch": {
      "value": "main"
    },
    "sku": {
      "value": "Standard"
    },
    "customDomainName": {
      "value": "guid.codes"
    },
    "enableCustomDomain": {
      "value": true
    },
    "validationMethod": {
      "value": "cname-delegation"
    },
    "tags": {
      "value": {
        "Environment": "Development",
        "Project": "GUID-API",
        "Application": "Static Web App",
        "Owner": "Development Team"
      }
    },
    "stagingEnvironmentPolicy": {
      "value": "Enabled"
    },
    "buildProperties": {
      "value": {
        "appLocation": "/src",
        "apiLocation": "/api",
        "outputLocation": "/dist",
        "skipGithubActionWorkflowGeneration": false,
        "appBuildCommand": "npm run build",
        "apiBuildCommand": "dotnet publish -c Release -o bin/Release/net8.0"
      }
    },
    "appSettings": {
      "value": {
        "WEBSITE_NODE_DEFAULT_VERSION": "18.x"
      }
    },
    "functionAppSettings": {
      "value": {
        "FUNCTIONS_WORKER_RUNTIME": "dotnet-isolated",
        "FUNCTIONS_EXTENSION_VERSION": "~4",
        "DOTNET_FRAMEWORK_VERSION": "v8.0",
        "AzureWebJobsStorage": "",
        "WEBSITE_CONTENTAZUREFILECONNECTIONSTRING": "",
        "WEBSITE_CONTENTSHARE": ""
      }
    }
  }
}