{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Run Azure Functions",
			"type": "shell",
			"command": "func",
			"args": [
				"start"
			],
			"group": "build",
			"isBackground": true,
			"options": {
				"cwd": "${workspaceFolder}/src/Api"
			},
			"problemMatcher": [],
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "shared",
				"showReuseMessage": true,
				"clear": false
			}
		},
		{
			"label": "Build TypeScript",
			"type": "shell",
			"command": "npx",
			"args": [
				"tsc"
			],
			"problemMatcher": [
				"$tsc"
			],
			"group": "build"
		},
		{
			"label": "Watch TypeScript",
			"type": "shell",
			"command": "npx",
			"args": [
				"tsc",
				"--watch"
			],
			"isBackground": true,
			"problemMatcher": [
				"$tsc-watch"
			],
			"group": "build"
		}
	]
}